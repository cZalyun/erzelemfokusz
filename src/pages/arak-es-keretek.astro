---
import Layout from '@layouts/Layout.astro';
import PageHeader from '@components/PageHeader.astro';
import { useTranslations } from '@i18n/utils';
import { getFeesById } from '@config/site';

const t = useTranslations('hu');
---

<Layout
  title={`${t.pricingPage.pageTitle} | ${t.meta.siteTitle}`}
  description={t.meta.siteDescription}
  locale="hu"
  canonicalPath="/arak-es-keretek"
>
  <PageHeader title={t.pricingPage.pageTitle} />

  <section class="py-16">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 lg:grid-cols-2">
        {t.pricingPage.services.map((service, index) => {
          const fees = getFeesById(service.id);
          return (
            <article class={`animate-on-scroll stagger-${Math.min(index + 1, 5)} flex flex-col gap-5 rounded-2xl border border-(--border-color) bg-(--bg-card) p-8 shadow-sm transition-shadow hover:shadow-md`}>
              <header class="space-y-2">
                <h2 class="font-heading text-2xl font-semibold text-(--text-primary)">
                  {service.title}
                </h2>
                <p class="text-sm font-medium text-(--text-secondary)">
                  {service.duration}
                </p>
                <p class="text-sm text-(--text-muted)">
                  {service.locationsLabel}
                </p>
              </header>

              <p class="text-base leading-relaxed text-(--text-secondary)">
                {service.description}
              </p>

              <div class="mt-auto border-t border-(--border-color) pt-5">
                <p class="text-sm font-semibold uppercase tracking-wide text-(--text-muted)">
                  {service.feeLabel}
                </p>
                <dl class="mt-3 space-y-2">
                  {fees.map((fee) => (
                    <div class="flex items-baseline justify-between gap-4">
                      <dt class="text-sm text-(--text-secondary)">{fee.city}</dt>
                      <dd class="font-heading text-2xl font-bold text-(--bg-accent)">
                        {fee.amount}
                      </dd>
                    </div>
                  ))}
                </dl>
              </div>
            </article>
          );
        })}
      </div>

      <div class="animate-on-scroll stagger-3 mt-10 space-y-6 rounded-2xl border border-(--border-color) bg-(--bg-card) p-8 shadow-sm sm:p-10">
        <p class="text-base leading-relaxed text-(--text-secondary)">
          {t.pricingPage.description}
        </p>
        <p class="text-base leading-relaxed text-(--text-secondary)">
          {t.pricingPage.cancellationPolicy}
        </p>
        <p class="text-sm italic text-(--text-muted)">
          {t.pricingPage.disclaimer}
        </p>
      </div>
    </div>
  </section>
</Layout>
