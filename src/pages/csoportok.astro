---
import Layout from '@layouts/Layout.astro';
import PageHeader from '@components/PageHeader.astro';
import { useTranslations } from '@i18n/utils';

const t = useTranslations('hu');
const telHref = `tel:${t.groupsPage.contactPhone.replace(/[^+\d]/g, '')}`;
---

<Layout
  title={`${t.groupsPage.pageTitle} | ${t.meta.siteTitle}`}
  description={t.meta.siteDescription}
  locale="hu"
  canonicalPath="/csoportok"
>
  <PageHeader title={t.groupsPage.pageTitle} />

  <section class="py-16">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 sm:grid-cols-2">
        {t.groupsPage.categories.map((category, index) => (
          <article class={`animate-on-scroll stagger-${Math.min(index + 1, 5)} flex flex-col gap-3 rounded-2xl border border-(--border-color) bg-(--bg-card) p-6 shadow-sm transition-shadow hover:shadow-md sm:p-8`}>
            <h2 class="font-heading text-xl font-semibold text-(--text-primary)">
              {category.title}
            </h2>
            <p class="text-base leading-relaxed text-(--text-secondary)">
              {category.description}
            </p>
          </article>
        ))}
      </div>

      <div class="animate-on-scroll stagger-3 mt-10 rounded-2xl border border-(--border-color) bg-(--bg-card) p-8 shadow-sm sm:p-10">
        <h2 class="font-heading text-xl font-semibold text-(--text-primary)">
          {t.groupsPage.joinInfo.title}
        </h2>
        <p class="mt-2 text-base leading-relaxed text-(--text-secondary)">
          {t.groupsPage.joinInfo.description}
        </p>

        <div class="mt-6 border-t border-(--border-color) pt-6">
          <p class="text-sm font-semibold uppercase tracking-wide text-(--text-muted)">
            {t.groupsPage.contactLabel}
          </p>
          <div class="mt-3 space-y-2">
            <a
              href={`mailto:${t.groupsPage.contactEmail}`}
              class="block text-(--text-secondary) transition-colors hover:text-(--text-primary)"
            >
              {t.groupsPage.contactEmail}
            </a>
            <a
              href={telHref}
              class="block text-(--text-secondary) transition-colors hover:text-(--text-primary)"
            >
              {t.groupsPage.contactPhone}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
